# ==========================================
# AI 미국 ETF 스윙 시그널 봇 설정 파일 (.env.example)
# 이 파일을 복사하여 .env 파일로 이름을 변경한 뒤 키를 입력하세요.
# ==========================================

# 1. 사용할 AI 종류 선택
# - openrouter: OpenRouter 무료 모델 (deepseek, qwen 등)
# - freellmapi: 로컬 FreeLLMAPI 프록시 (34개 무료 LLM 통합 라우터 http://localhost:3001/v1)
# - groq      : Groq 초고속 추론 (Llama 3.3 무료)
# - gemini    : Google Gemini API
AI_PROVIDER=openrouter

# 2. LLM API 키 설정
# - OpenRouter: https://openrouter.ai/keys
# - FreeLLMAPI: 대시보드(http://localhost:3001)에서 발급받은 통합 키 (freellmapi-...)
# - Groq      : https://console.groq.com/keys
LLM_API_KEY=your_api_key_here

# 3. LLM 기본 주소 및 모델 (AI_PROVIDER에 따라 자동 기본값 배정, 필요시 오버라이드)
# [FreeLLMAPI 사용 시]: LLM_BASE_URL=http://localhost:3001/v1 / LLM_MODEL=auto:smart
# [Groq 사용 시]      : LLM_BASE_URL=https://api.groq.com/openai/v1 / LLM_MODEL=llama-3.3-70b-versatile
# [OpenRouter 사용 시]: LLM_BASE_URL=https://openrouter.ai/api/v1 / LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free

# 4. 텔레그램 봇 설정 (알림 발송용)
# 봇 토큰 발급: 텔레그램에서 @BotFather 검색 후 /newbot 입력
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 챗 ID 확인: 봇에게 아무 메시지나 보낸 후 https://api.telegram.org/bot<토큰>/getUpdates 접속하여 id 확인
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
