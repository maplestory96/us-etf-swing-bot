# ==========================================
# AI 미국 ETF 스윙 시그널 봇 설정 파일 (.env.example)
# 이 파일을 복사하여 .env 파일로 이름을 변경한 뒤 키를 입력하세요.
# ==========================================

# 1. 사용할 AI 종류 선택 (기본값: openrouter 무료 모델 - 카드 등록/결제 불필요!)
AI_PROVIDER=openrouter

# 2. OpenRouter API 키 (발급처: https://openrouter.ai/keys - 무료 가입 후 바로 발급)
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1

# 3. 사용할 무료 모델명 (:free 가 붙은 모델은 결제 없이 100% 무료!)
# 기본 지정된 모델이 일시 혼잡할 경우 봇이 알아서 다른 무료 모델(DeepSeek/Qwen/Llama)로 자동 전환합니다.
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free

# 4. 텔레그램 봇 설정 (알림 발송용)
# 봇 토큰 발급: 텔레그램에서 @BotFather 검색 후 /newbot 입력
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 챗 ID 확인: 봇에게 아무 메시지나 보낸 후 https://api.telegram.org/bot<토큰>/getUpdates 접속하여 id 확인
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
